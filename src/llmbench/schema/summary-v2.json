{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanttrio.github.io/llm-eval-bench/schema/summary-v2.json",
  "type": "object",
  "required": ["schema_version", "run_id", "mode", "model", "base_url", "config", "quality", "performance"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string"},
    "model": {"type": "string"},
    "base_url": {"type": "string"},
    "config": {"type": "object"},
    "quality": {
      "type": "object",
      "required": ["scored_samples", "by_dataset", "by_category", "by_question_type", "quality_valid"],
      "properties": {
        "scored_samples": {"type": "integer", "minimum": 0},
        "by_dataset": {"type": "object"},
        "by_category": {"type": "object"},
        "by_question_type": {"type": "object"},
        "quality_valid": {"type": "boolean"}
      }
    },
    "performance": {
      "type": "object",
      "required": ["total_requests", "successful_requests", "failed_requests", "error_rate", "latency_ms"],
      "properties": {
        "total_requests": {"type": "integer", "minimum": 0},
        "successful_requests": {"type": "integer", "minimum": 0},
        "failed_requests": {"type": "integer", "minimum": 0},
        "unsupported_requests": {"type": "integer", "minimum": 0},
        "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "truncation_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "latency_ms": {"type": "object"}
      }
    }
  }
}
