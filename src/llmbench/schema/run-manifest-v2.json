{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanttrio.github.io/llm-eval-bench/schema/run-manifest-v2.json",
  "type": "object",
  "required": ["schema_version", "run_id", "llmbench_version", "mode", "model", "base_url", "config", "fingerprint"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "llmbench_version": {"type": "string"},
    "mode": {"type": "string"},
    "model": {"type": "string"},
    "base_url": {"type": "string"},
    "config": {"type": "object"},
    "datasets": {"type": "object"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
