include CHANGELOG.md
include LICENSE
include README.md
include THIRD_PARTY_DATASETS.md
recursive-include docs *.md
recursive-include data-packs *.py *.toml *.md *.json NOTICE LICENSE-*
recursive-exclude data-packs *.jsonl
prune data-packs/*/dist
prune data-packs/*/build
prune data-packs/*/*.egg-info
recursive-include examples *.yaml
recursive-include executor *
recursive-include scripts *.py
